# Copy to .env (or set in your host) — never commit real values.
PORT=3001
SESSION_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/jjcargo.db
# First admin account, used only when the database is empty
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Optional: API key sent as the "apikey" header to the status webhook (Settings → Customer website sync)
STATUS_WEBHOOK_KEY=
