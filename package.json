{
  "name": "jjcargo-web",
  "version": "1.0.0",
  "description": "JJ Cargo back office (web version of JJCargoForm)",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p .",
    "test": "tsx scripts/e2e.ts",
    "seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "jsbarcode": "^3.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "private": true,
  "type": "module"
}
